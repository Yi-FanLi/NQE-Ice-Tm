@SET PROJECT B97M_rV

&GLOBAL
  PROJECT ${PROJECT}
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL LOW
  PREFERRED_FFT_LIBRARY FFTW
  FFTW_PLAN_TYPE MEASURE
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0

    &MGRID
      CUTOFF 800
      NGRIDS 5
    &END MGRID

    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-14
      EXTRAPOLATION_ORDER 3
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      MAX_SCF 80
      EPS_SCF 5.0E-7
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
        ENERGY_GAP 0.005
      &END OT
      &OUTER_SCF
        MAX_SCF 20
        EPS_SCF 5.0E-7
      &END OUTER_SCF
    &END SCF

    &XC
      &XC_FUNCTIONAL
        &MGGA_XC_B97M_V
        &END MGGA_XC_B97M_V
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL NON_LOCAL
        &NON_LOCAL
          TYPE RVV10
          PARAMETERS 6.0 0.01
          KERNEL_FILE_NAME rVV10_kernel_table.dat
          CUTOFF 800
        &END NON_LOCAL
      &END VDW_POTENTIAL
      &XC_GRID
        XC_DERIV NN50_SMOOTH
      &END XC_GRID
    &END XC
  &END DFT

  &SUBSYS
    &CELL
      ABC [angstrom] 12.420000 12.420000 12.420000
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME structure.xyz
      COORD_FILE_FORMAT XYZ
      CONN_FILE_FORMAT GENERATE
    &END TOPOLOGY
    &KIND H
      ELEMENT H
      BASIS_SET TZV2P-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET TZV2P-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS

  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL
